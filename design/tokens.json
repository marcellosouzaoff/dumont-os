{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DUMONT OS",
  "version": "1.2.0",
  "status": "pilot-dev-unverified",
  "palette": {
    "cloud": {
      "value": "#F0EEE9",
      "type": "color"
    },
    "white": {
      "value": "#FFFFFF",
      "type": "color"
    },
    "charcoal": {
      "value": "#414352",
      "type": "color"
    },
    "black": {
      "value": "#272836",
      "type": "color"
    },
    "mocha": {
      "value": "#BCA483",
      "type": "color"
    },
    "red": {
      "value": "#CD212A",
      "type": "color"
    },
    "greenStatus": {
      "value": "#287D53",
      "type": "color"
    },
    "yellowStatus": {
      "value": "#B78319",
      "type": "color"
    },
    "unknownStatus": {
      "value": "#626474",
      "type": "color"
    },
    "baritone": {
      "value": "#272836",
      "type": "color"
    },
    "accent": {
      "value": "#BCA483",
      "type": "color"
    }
  },
  "typography": {
    "ui": "DM Sans",
    "editorial": "Cormorant Garamond"
  },
  "spacingDp": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radiusDp": {
    "control": 12,
    "panel": 16,
    "dock": 20
  },
  "border": {
    "color": "#9999A2",
    "defaultDp": 1,
    "focusDp": 2
  },
  "touchTargetMinimumDp": 48,
  "rules": {
    "topBrand": "DUMONT",
    "bars": [
      "top",
      "bottomDock"
    ],
    "center": "application folder",
    "noSamsungAppleIconsInSystemUI": true,
    "knoxPreserved": true,
    "androidNotReplaced": true,
    "ghostSidebarHiddenByDefault": true,
    "dexWindowManager": "Samsung/Android native; no private API"
  }
}
