{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DUMONT OS",
  "version": "0.3.0",
  "status": "pre-code",
  "palette": {
    "cloud": {
      "value": "#F1EEE7",
      "type": "color"
    },
    "white": {
      "value": "#FFFFFF",
      "type": "color"
    },
    "charcoal": {
      "value": "#4E5353",
      "type": "color"
    },
    "black": {
      "value": "#252525",
      "type": "color"
    },
    "mocha": {
      "value": "#A47864",
      "type": "color"
    },
    "red": {
      "value": "#CD212A",
      "type": "color"
    },
    "greenStatus": {
      "value": "#287D53",
      "type": "color"
    },
    "yellowStatus": {
      "value": "#B78319",
      "type": "color"
    },
    "unknownStatus": {
      "value": "#4E5353",
      "type": "color"
    }
  },
  "typography": {
    "ui": "DM Sans",
    "editorial": "Cormorant Garamond"
  },
  "spacingDp": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radiusDp": {
    "control": 12,
    "panel": 16,
    "dock": 20
  },
  "border": {
    "color": "#4E5353",
    "defaultDp": 1,
    "focusDp": 2
  },
  "touchTargetMinimumDp": 48,
  "rules": {
    "topBrand": "DUMONT",
    "bars": [
      "top",
      "bottomDock"
    ],
    "center": "application folder",
    "noSamsungAppleIconsInSystemUI": true,
    "knoxPreserved": true,
    "androidNotReplaced": true
  }
}
